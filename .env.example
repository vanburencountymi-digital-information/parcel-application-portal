# Required — no default. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# The following are optional as they have defaults in settings.py; set as needed.
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Background tasks default to running synchronously (ImmediateBackend). The
# DB-backed worker (django-tasks-db) is installed and migrated, just not the
# default yet — set this to switch to it (and run the `worker` service):
# TASKS_BACKEND=django_tasks_db.DatabaseBackend

# Error monitoring (Sentry), via common/services.py's LoggingService. Unset
# SENTRY_DSN (the default) makes the SDK a no-op — not set up yet.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Parcel service (where parcels are looked up). Required for parcel search to work.
# Leave the token unset while the service is unauthenticated.
# PARCEL_SERVICE_URL=
# PARCEL_SERVICE_TOKEN=
# PARCEL_SERVICE_TIMEOUT=10

# Unset S3_BUCKET_NAME (the default) keeps local FileSystemStorage.
# See README's "Media storage (Garage)" section for local-dev values.
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION_NAME=auto
# S3_SIGNATURE_VERSION=s3v4
# S3_ADDRESSING_STYLE=path (needed for Garage)
